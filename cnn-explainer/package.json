{
  "name": "dnn-explainer",
  "version": "1.0.0",
  "description": "An interactive visualization for learning dense (fully connected) neural networks",
  "devDependencies": {
    "@rollup/plugin-replace": "^2.3.2",
    "gh-pages": "^6.0.0",
    "rollup": "^1.27.13",
    "rollup-plugin-commonjs": "^10.0.0",
    "rollup-plugin-livereload": "^1.0.0",
    "rollup-plugin-node-resolve": "^5.2.0",
    "rollup-plugin-svelte": "~6.1.1",
    "rollup-plugin-terser": "^5.1.3",
    "svelte": "^3.31.0"
  },
  "dependencies": {
    "sirv-cli": "^0.4.4"
  },
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "train": "node dnn-mlp/train.js",
    "verify": "node dnn-mlp/verify.mjs",
    "test:engine": "node dnn-mlp/test-engine.mjs",
    "test:animation": "node dnn-mlp/test-animation.mjs",
    "test:inspection": "node dnn-mlp/test-inspection.mjs",
    "test:panels": "node dnn-mlp/test-panels.mjs",
    "test:phase4": "node dnn-mlp/test-phase4.mjs",
    "test:render": "node dnn-mlp/smoke-render.mjs",
    "test": "node dnn-mlp/test-engine.mjs && node dnn-mlp/test-animation.mjs && node dnn-mlp/test-inspection.mjs && node dnn-mlp/test-panels.mjs && node dnn-mlp/test-phase4.mjs",
    "start": "sirv public --single",
    "start:dev": "sirv public --single --dev --port 3000"
  }
}
